# Copy to .env.local and fill in. Never commit real keys.

# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Qloo hackathon key (emailed by Qloo). Leave empty to run in mock mode.
QLOO_API_KEY=
# Only this base URL works with hackathon keys
QLOO_BASE_URL=https://hackathon.api.qloo.com
